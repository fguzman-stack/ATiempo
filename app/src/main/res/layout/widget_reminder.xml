<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A TIEMPO • PRÓXIMA INTENCIÓN"
        android:textColor="#99FFFFFF"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <TextView
        android:id="@+id/widget_reminder_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="8dp"
        android:text="Sin recordatorios activos"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_reminder_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_reminder_name"
        android:layout_marginTop="2dp"
        android:text="Pulsa para añadir uno"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Subtle accent icon or indicator could go here if needed -->

</RelativeLayout>
